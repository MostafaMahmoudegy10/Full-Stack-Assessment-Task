# Copy this file to .env in the repository root before starting the apps.
# These are separate local-development settings. For one Heroku app, see HEROKU.md;
# set secrets in Config Vars and let the deployment scripts manage ports and /api.

# --- API ---
MONGODB_URI=mongodb://localhost:27018/projectflow?replicaSet=rs0
JWT_SECRET=local-development-secret
JWT_EXPIRES_IN=7d
API_PORT=4732
# Frontend origin allowed by API CORS.
WEB_ORIGIN=http://localhost:3742

# --- Web ---
# API base URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4732

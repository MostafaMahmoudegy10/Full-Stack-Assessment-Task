{
  "name": "projectflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node scripts/start-heroku.cjs",
    "test:deployment": "node scripts/test-deployment.cjs",
    "heroku-prebuild": "corepack enable pnpm",
    "heroku-postbuild": "node scripts/build-heroku.cjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "seed": "turbo run seed --filter=@projectflow/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
